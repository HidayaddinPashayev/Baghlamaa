rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    function isCarrier(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == 'carrier' || get(/databases/$(database)/documents/users/$(uid)).data.role == 'both';
    }
    
    function isSender(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == 'sender' || get(/databases/$(database)/documents/users/$(uid)).data.role == 'both';
    }
    
    // User collection rules
    match /users/{uid} {
      allow create: if isAuthenticated() && isOwner(uid);
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(uid);
      allow delete: if isAuthenticated() && isOwner(uid);
    }
    
    // Route collection rules (created by carriers)
    match /routes/{routeId} {
      allow create: if isAuthenticated() && isCarrier(request.auth.uid);
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.carrierId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.carrierId == request.auth.uid;
      
      // Route stops subcollection
      match /stops/{stopId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && get(/databases/$(database)/documents/routes/$(routeId)).data.carrierId == request.auth.uid;
      }
    }
    
    // Booking collection rules
    match /bookings/{bookingId} {
      allow create: if isAuthenticated() && isSender(request.auth.uid);
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.carrierId == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.carrierId == request.auth.uid);
      allow delete: if false; // Bookings should not be deleted, only cancelled
      
      // Chat messages subcollection
      match /messages/{messageId} {
        allow create: if isAuthenticated() && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.senderId == request.auth.uid || get(/databases/$(database)/documents/bookings/$(bookingId)).data.carrierId == request.auth.uid);
        allow read: if isAuthenticated() && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.senderId == request.auth.uid || get(/databases/$(database)/documents/bookings/$(bookingId)).data.carrierId == request.auth.uid);
      }
    }
    
    // Rating collection rules
    match /ratings/{ratingId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false; // Ratings should not be updated or deleted
    }
    
    // Dispute collection rules
    match /disputes/{disputeId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.carrierId == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.senderId == request.auth.uid || resource.data.carrierId == request.auth.uid);
      allow delete: if false; // Disputes should not be deleted
      
      // Evidence subcollection
      match /evidence/{evidenceId} {
        allow create, read: if isAuthenticated() && (get(/databases/$(database)/documents/disputes/$(disputeId)).data.senderId == request.auth.uid || get(/databases/$(database)/documents/disputes/$(disputeId)).data.carrierId == request.auth.uid);
      }
    }
    
    // Route alerts collection
    match /route_alerts/{alertId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
